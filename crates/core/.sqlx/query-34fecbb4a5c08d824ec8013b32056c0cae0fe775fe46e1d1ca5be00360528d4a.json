  "query": "\n        SELECT\n            id as \"id!\",\n            habit_id as \"habit_id!\",\n            date as \"date!\",\n            value as \"value!\",\n            created_at as \"created_at!\",\n            updated_at as \"updated_at!\",\n            deleted_at\n        FROM habit_logs\n        WHERE habit_id = ?1\n          AND date >= ?2\n          AND date <= ?3\n          AND deleted_at IS NULL\n        ORDER BY date ASC\n        ",
