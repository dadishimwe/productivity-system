{
  "db_name": "SQLite",
  "query": "\n        SELECT\n            id as \"id!\",\n            calendar_id as \"calendar_id!\",\n            title as \"title!\",\n            description,\n            start_ms as \"start_ms!\",\n            end_ms as \"end_ms!\",\n            all_day as \"all_day!\",\n            rrule,\n            source as \"source!\",\n            external_event_id,\n            external_calendar_id,\n            last_synced_at,\n            created_at as \"created_at!\",\n            updated_at as \"updated_at!\",\n            deleted_at\n        FROM events\n        WHERE calendar_id = ?1\n          AND deleted_at IS NULL\n          AND (\n            (rrule IS NULL AND start_ms < ?3 AND end_ms > ?2)\n            OR rrule IS NOT NULL\n          )\n        ",
